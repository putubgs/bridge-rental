# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# HyperPay (COPYandPAY). Use https://eu-test.oppwa.com for test, https://eu-prod.oppwa.com for live.
NEXT_PUBLIC_PAYMENT_BASE_URL=payment-base-url
PAYMENT_ACCESS_TOKEN=hyperpay-access-token
PAYMENT_ENTITY_ID=hyperpay-entity-id
NEXT_PUBLIC_SHOPPER_RESULT_URL=https://your-domain.com/reservation/review

# SendGrid. The from address must be a verified sender on the SendGrid account.
SENDGRID_API_KEY=sendgrid-api-key
SENDGRID_FROM_EMAIL=tech@jo-limo.com
SENDGRID_FROM_NAME=Bridge Rent-A-Car
